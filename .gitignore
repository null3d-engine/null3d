# Maintainers' private build plan, research and experiments
.internal/

# Dependencies and build output
node_modules/
target/
dist/
*.tsbuildinfo

# The shader modules. Every command that reads them builds them first when they are missing or out
# of date (tools/shaders.ts), and the engine's npm package holds them.
packages/engine/src/generated/shaders*.ts
packages/engine/src/generated/shaders-*.js
packages/engine/src/generated/shader-features.ts
packages/engine/src/generated/shader-permutations.ts
# Each GPU path's shared table of shader paragraphs, which the device modules import by name.
packages/engine/src/generated/shader-paragraphs-*.js

# Test output
coverage/
test-results/
playwright-report/

# Local settings
.claude/settings.local.json
.DS_Store
*.log

# What a package's pack step makes: the built JavaScript and declarations, the license copies and
# the engine's copy of the docs (tools/lib/packages.ts and tools/lib/pack.ts)
packages/*/lib/
packages/*/LICENSE-MIT
packages/*/LICENSE-APACHE
packages/engine/docs/

# Lock files of test fixtures
tools/fixtures/*/Cargo.lock

# Working copies of parallel helpers
.claude/worktrees/

# Generated files, which `bun install`, the git hooks and `bun run docs` write (tools/lib/generated.ts,
# D-105). Written pages link to them.
.claude/skills/
.dev/tested-device-tables.md
docs/api/reference/
docs/concepts/quality-preset-tables.md
docs/errors/
docs/guides/first-use-shaders.md
docs/pages.md
docs/porting/threejs-mapping.md
docs/shaders/library.md
skills/null3d-port-threejs/references/api-mapping.md
skills/null3d-port-threejs/references/threejs-mapping.json
# Placeholder pages of planned pages. Take a page off this list when you write it.
docs/guides/deploying.md
docs/porting/react-three-fiber.md
docs/porting/threejs-loop-and-threads.md
docs/porting/threejs-materials.md
docs/porting/threejs-overview.md
