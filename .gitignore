# Maintainers' private build plan, research and experiments
.internal/

# Dependencies and build output
node_modules/
target/
dist/
*.tsbuildinfo

# The shader modules. Every command that reads them builds them first when they are missing or out
# of date (tools/shaders.ts), and the engine's npm package holds them.
packages/engine/src/generated/shaders*.ts
packages/engine/src/generated/shaders-*.js

# Test output
coverage/
test-results/
playwright-report/

# Local settings
.claude/settings.local.json
.DS_Store
*.log

# What a package's pack step makes: the built JavaScript and declarations, the license copies and
# the engine's copy of the docs (tools/lib/packages.ts)
packages/*/lib/
packages/*/LICENSE-MIT
packages/*/LICENSE-APACHE
packages/engine/docs/

# Lock files of test fixtures
tools/fixtures/*/Cargo.lock

# Working copies of parallel helpers
.claude/worktrees/
