{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"allowJs": true
	},
	"include": [
		"tools/**/*.ts",
		"packages/*/src/**/*.test.ts",
		"packages/vite-plugin/src/**/*.ts",
		"tests/*.ts",
		"tests/lib/**/*.ts",
		"tests/image/**/*.ts",
		"tests/fixtures/*/vite.config.ts",
		"vite.config.ts"
	],
	"exclude": ["packages/engine/**"]
}
