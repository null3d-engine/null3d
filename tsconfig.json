{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true
	},
	"include": [
		"tools/**/*.ts",
		"packages/vite-plugin/src/**/*.ts",
		"tests/*.ts",
		"tests/lib/**/*.ts",
		"tests/image/**/*.ts"
	]
}
