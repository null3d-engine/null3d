{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"customConditions": ["null3d-source"],
		"types": ["bun"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"allowJs": true
	},
	"include": [
		"tools/**/*.ts",
		// A tool that writes a GIF reads the same package, so its types join this project.
		"bench/gifenc.d.ts",
		"packages/*/src/**/*.test.ts",
		"packages/vite-plugin/src/**/*.ts",
		"tests/*.ts",
		"tests/lib/**/*.ts",
		"tests/image/**/*.ts",
		"tests/fixtures/*/vite.config.ts",
		"examples/vite.build.config.ts",
		"vite.config.ts"
	],
	"exclude": [
		"packages/engine/**",
		"packages/controls/**",
		"packages/geometry/**",
		"packages/grass/**",
		"packages/particles/**",
		"packages/impostors/**",
		"packages/terrain/**",
		"packages/vegetation/**",
		"packages/three-compat/**",
		"packages/splats/**",
		"packages/water/**",
		"packages/wind/**",
		"packages/sound/**",
		// The vegetation add-on's own tools and tests, which tsconfig.vegetation.json checks with the
		// add-on's switch on (tools/lib/vegetation-switch.ts lists them).
		"tests/image/plant-*.spec.ts",
		"tests/lib/plant-species.test.ts",
		"tests/lib/leaf-card-rule.test.ts",
		"tests/lib/species-walk.ts",
		"tools/plant-*",
		"tools/plant-*/**",
		"tools/vegetation-registry.ts",
		"tools/lib/plant-*",
		"tools/lib/plant-*/**",
		"tools/lib/vegetation-registry.ts",
		"tools/lib/vegetation-registry.test.ts"
	]
}
