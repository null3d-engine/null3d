{
	"name": "@null3d/engine",
	"version": "0.0.0",
	"description": "The null3D engine, a browser 3D engine for games and heavy 3D apps: the TypeScript API, the page shim, the worker entry points, both WebAssembly builds and the docs.",
	"license": "MIT OR Apache-2.0",
	"author": "Ramesh Nair (https://hiddentao.com)",
	"homepage": "https://github.com/null3d-engine/null3d#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/null3d-engine/null3d.git",
		"directory": "packages/engine"
	},
	"bugs": {
		"url": "https://github.com/null3d-engine/null3d/issues"
	},
	"keywords": [
		"null3d",
		"3d",
		"webgpu",
		"webgl2",
		"wasm",
		"game-engine",
		"threejs"
	],
	"type": "module",
	"exports": {
		".": {
			"null3d-source": "./src/index.ts",
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./internal": {
			"null3d-source": "./src/internal.ts"
		},
		"./stats": {
			"null3d-source": "./src/shared/stats.ts"
		},
		"./wasm/*": "./dist/wasm/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"dist/wasm/*/*.js",
		"dist/wasm/*/*.wasm",
		"dist/wasm/*/*.json",
		"vendor",
		"environments",
		"docs",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepack": "bun ../../tools/build-package.ts engine"
	},
	"dependencies": {
		"meshoptimizer": "1.3.0"
	},
	"devDependencies": {
		"@types/three": "0.186.0",
		"@webgpu/types": "0.1.74",
		"three": "0.186.1"
	}
}
