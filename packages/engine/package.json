{
	"name": "@null3d/engine",
	"version": "0.1.0",
	"description": "The null3D engine, a high-performance browser 3D engine for agents, faster than three.js, with wide device compatibility: the TypeScript API, the page shim, the worker entry points, both WebAssembly builds and the docs.",
	"license": "MIT OR Apache-2.0",
	"author": "Ramesh Nair (https://hiddentao.com)",
	"homepage": "https://github.com/null3d-engine/null3d#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/null3d-engine/null3d.git",
		"directory": "packages/engine"
	},
	"bugs": {
		"url": "https://github.com/null3d-engine/null3d/issues"
	},
	"keywords": [
		"null3d",
		"3d",
		"webgpu",
		"webgl2",
		"wasm",
		"game-engine",
		"threejs"
	],
	"type": "module",
	"exports": {
		".": {
			"null3d-source": "./src/index.ts",
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./internal": {
			"null3d-source": "./src/internal.ts"
		},
		"./stats": {
			"null3d-source": "./src/stats.ts",
			"types": "./lib/stats.d.ts",
			"default": "./lib/stats.js"
		},
		"./math": {
			"null3d-source": "./src/math/index.ts",
			"types": "./lib/math/index.d.ts",
			"default": "./lib/math/index.js"
		},
		"./math/vec3": {
			"null3d-source": "./src/math/vec3.ts",
			"types": "./lib/math/vec3.d.ts",
			"default": "./lib/math/vec3.js"
		},
		"./math/quat": {
			"null3d-source": "./src/math/quat.ts",
			"types": "./lib/math/quat.d.ts",
			"default": "./lib/math/quat.js"
		},
		"./math/mat4": {
			"null3d-source": "./src/math/mat4.ts",
			"types": "./lib/math/mat4.d.ts",
			"default": "./lib/math/mat4.js"
		},
		"./math/math": {
			"null3d-source": "./src/math/math.ts",
			"types": "./lib/math/math.d.ts",
			"default": "./lib/math/math.js"
		},
		"./early-core": {
			"null3d-source": "./src/page/early-core.ts",
			"default": "./lib/page/early-core.js"
		},
		"./levels-planner": {
			"types": "./levels/planner.d.ts",
			"default": "./levels/planner.js"
		},
		"./pieces-planner": {
			"types": "./levels/pieces.d.ts",
			"default": "./levels/pieces.js"
		},
		"./wasm/*": "./dist/wasm/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"!lib/generated/shaders*.js",
		"!lib/generated/shader-features.js",
		"!lib/generated/shader-paragraphs-*.js",
		"dist/wasm/*/*.js",
		"dist/wasm/*/*.wasm",
		"vendor",
		"levels",
		"docs",
		"LICENSE-MIT",
		"LICENSE-APACHE",
		"THIRD-PARTY-NOTICES.txt"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepack": "bun ../../tools/build-package.ts engine"
	},
	"devDependencies": {
		"@types/three": "0.186.0",
		"@webgpu/types": "0.1.74",
		"meshoptimizer": "1.3.0",
		"three": "0.186.1"
	}
}
