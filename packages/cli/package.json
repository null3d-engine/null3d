{
	"name": "@null3d/cli",
	"version": "0.0.0",
	"description": "The command-line tool for null3D, a browser 3D engine for games and heavy 3D apps. It draws frames of a project's scenes in headless Chrome, and tests them against reference images.",
	"license": "MIT OR Apache-2.0",
	"author": "Ramesh Nair (https://hiddentao.com)",
	"homepage": "https://github.com/null3d-engine/null3d#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/null3d-engine/null3d.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/null3d-engine/null3d/issues"
	},
	"keywords": [
		"null3d",
		"3d",
		"webgpu",
		"webgl2",
		"wasm",
		"game-engine",
		"threejs"
	],
	"type": "module",
	"bin": {
		"null3d": "bin/null3d.js"
	},
	"files": [
		"bin",
		"src",
		"!src/**/*.test.ts",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"prepack": "cp ../../LICENSE-MIT ../../LICENSE-APACHE ."
	},
	"dependencies": {
		"fast-png": "8.0.0",
		"pixelmatch": "7.2.0",
		"playwright-core": "1.63.0"
	},
	"devDependencies": {
		"vite": "8.3.1"
	}
}
