{
	"name": "sokko3d",
	"version": "0.0.0",
	"description": "The command-line tool for sokko3d, a browser 3D engine for games and heavy 3D apps. This first version only prints the project's status.",
	"license": "MIT OR Apache-2.0",
	"author": "Ramesh Nair (https://hiddentao.com)",
	"homepage": "https://github.com/sokko3d/sokko3d#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sokko3d/sokko3d.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/sokko3d/sokko3d/issues"
	},
	"keywords": [
		"sokko3d",
		"3d",
		"webgpu",
		"webgl2",
		"wasm",
		"game-engine",
		"threejs"
	],
	"type": "module",
	"bin": {
		"sokko3d": "bin/sokko3d.js"
	},
	"files": [
		"bin",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"prepack": "cp ../../LICENSE-MIT ../../LICENSE-APACHE ."
	}
}
