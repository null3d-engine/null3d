{
	"name": "@null3d/water",
	"version": "0.0.0",
	"description": "Water for null3D sketches: a river and a lake from one description, with waves, ripples, caustics, foam, soft shores that read the scene's depth, a reflection pass whose cadence follows the quality preset, and the view from under the surface, built on the engine's public API.",
	"license": "MIT OR Apache-2.0",
	"author": "Ramesh Nair (https://hiddentao.com)",
	"homepage": "https://github.com/null3d-engine/null3d#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/null3d-engine/null3d.git",
		"directory": "packages/water"
	},
	"bugs": {
		"url": "https://github.com/null3d-engine/null3d/issues"
	},
	"keywords": [
		"null3d",
		"3d",
		"water",
		"river",
		"lake",
		"reflection",
		"caustics",
		"underwater"
	],
	"type": "module",
	"exports": {
		".": {
			"null3d-source": "./src/index.ts",
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepack": "bun ../../tools/build-package.ts water"
	},
	"peerDependencies": {
		"@null3d/engine": "workspace:*"
	},
	"devDependencies": {
		"@null3d/engine": "workspace:*",
		"@null3d/vite-plugin": "workspace:*",
		"@webgpu/types": "0.1.74"
	}
}
