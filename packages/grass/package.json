{
	"name": "@null3d/grass",
	"version": "0.1.2",
	"description": "GPU grass for null3D sketches: tufts of bent blades over a ground, placed by integer hashes, built in a compute pass on WebGPU with near shadows, swaying in the wind add-on's field, built on the engine's public API.",
	"license": "MIT OR Apache-2.0",
	"author": "Ramesh Nair (https://hiddentao.com)",
	"homepage": "https://github.com/null3d-engine/null3d#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/null3d-engine/null3d.git",
		"directory": "packages/grass"
	},
	"bugs": {
		"url": "https://github.com/null3d-engine/null3d/issues"
	},
	"keywords": [
		"null3d",
		"3d",
		"grass",
		"vegetation",
		"wind",
		"compute",
		"webgpu",
		"webgl2"
	],
	"type": "module",
	"exports": {
		".": {
			"null3d-source": "./src/index.ts",
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./hash": {
			"null3d-source": "./src/hash.ts",
			"types": "./lib/hash.d.ts",
			"default": "./lib/hash.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepack": "bun ../../tools/build-package.ts grass"
	},
	"peerDependencies": {
		"@null3d/engine": "workspace:*",
		"@null3d/wind": "workspace:*"
	},
	"devDependencies": {
		"@null3d/engine": "workspace:*",
		"@null3d/vite-plugin": "workspace:*",
		"@null3d/wind": "workspace:*",
		"@webgpu/types": "0.1.74"
	}
}
