{
	"name": "null3d",
	"version": "0.0.0",
	"description": "The null3d command under its plain name, so npx null3d works anywhere. It runs @null3d/cli, the command-line tool for null3d, a browser 3D engine for games and heavy 3D apps.",
	"license": "MIT OR Apache-2.0",
	"author": "Ramesh Nair (https://hiddentao.com)",
	"homepage": "https://github.com/null3d-engine/null3d#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/null3d-engine/null3d.git",
		"directory": "packages/null3d"
	},
	"bugs": {
		"url": "https://github.com/null3d-engine/null3d/issues"
	},
	"keywords": [
		"null3d",
		"3d",
		"webgpu",
		"webgl2",
		"wasm",
		"game-engine",
		"threejs"
	],
	"type": "module",
	"bin": {
		"null3d": "bin/null3d.js"
	},
	"files": [
		"bin",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"dependencies": {
		"@null3d/cli": "latest"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"prepack": "cp ../../LICENSE-MIT ../../LICENSE-APACHE ."
	}
}
