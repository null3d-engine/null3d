{
	"name": "@null3d/three-compat",
	"version": "0.0.0",
	"description": "three.js looks for null3D sketches: Reinhard and Cineon tone curves through the engine's tone-curve setting, and an outline with three.js OutlinePass's glow, pulse and blurred edge, built on the engine's public API.",
	"license": "MIT OR Apache-2.0",
	"author": "Ramesh Nair (https://hiddentao.com)",
	"homepage": "https://github.com/null3d-engine/null3d#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/null3d-engine/null3d.git",
		"directory": "packages/three-compat"
	},
	"bugs": {
		"url": "https://github.com/null3d-engine/null3d/issues"
	},
	"keywords": [
		"null3d",
		"3d",
		"threejs",
		"tone-mapping",
		"outline",
		"reinhard",
		"cineon"
	],
	"type": "module",
	"exports": {
		".": {
			"null3d-source": "./src/index.ts",
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"LICENSE-MIT",
		"LICENSE-APACHE",
		"THIRD-PARTY-NOTICES.txt"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepack": "bun ../../tools/build-package.ts three-compat"
	},
	"peerDependencies": {
		"@null3d/engine": "workspace:*"
	},
	"devDependencies": {
		"@null3d/engine": "workspace:*",
		"@null3d/vite-plugin": "workspace:*",
		"@webgpu/types": "0.1.74"
	}
}
